{
  "name": "@cortex/contracts",
  "version": "0.2.0",
  "description": "Canonical Cortex shared JSON Schema contracts (ADR-0014) as an installable, versioned package. Ships the schemas as package data plus loaders (schemasDir/getSchema/allSchemas) so every pillar depends on a pinned version instead of a relative parents[N]/cortex/contracts path.",
  "type": "module",
  "main": "./index.mjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "index.d.ts",
    "*.schema.json",
    "*.ts",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node tests/run-all-tests.js"
  },
  "keywords": [
    "cortex",
    "contracts",
    "json-schema",
    "schemas",
    "adr-0014"
  ],
  "homepage": "https://github.com/brycemurad0/cortex-contracts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brycemurad0/cortex-contracts.git"
  },
  "license": "MIT",
  "private": false
}
